---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { links, experience, selfService, alsoBuilt } from '../data/site';
import { projects } from '../data/projects';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

const platformDiagram = existsSync(join(process.cwd(), 'public', 'diagrams', 'platform.html'));

const stats = [
  ['calendar-days', '11+', 'years across databases, cloud and platforms'],
  ['users', '200+', 'employees use the platform I build and run'],
  ['zap', '120', 'documented automations, about 40 hours saved a week'],
  ['bot', '250+', 'API operations available to AI assistants'],
];

const projectIcons: Record<string, string> = {
  workflow: 'workflow', mcp: 'plug', template: 'layout-template', timesheets: 'arrow-left-right', rag: 'file-search', agents: 'git-pull-request-arrow',
};
const kindIcons: Record<string, string> = {
  Releases: 'rocket', Environments: 'server', 'Database access': 'user-cog', Data: 'database-zap', Accounts: 'building-2',
  Email: 'mail-check', Documents: 'file-check', Insight: 'chart-column',
  Operations: 'activity', Security: 'shield-check', Packages: 'package', Infrastructure: 'cloud', Cost: 'piggy-bank',
};
// Brand logos where Simple Icons has them, a generic icon otherwise.
const systems: [string, { brand?: string; name?: string }][] = [
  ['NetSuite', { name: 'building-2' }], ['Snowflake', { brand: 'snowflake' }], ['ServiceNow', { name: 'life-buoy' }],
  ['Certinia', { name: 'briefcase' }], ['Jira', { brand: 'jira' }], ['Confluence', { brand: 'confluence' }], ['Box', { brand: 'box' }],
  ['Microsoft Teams', { name: 'message-square' }], ['Entra ID', { name: 'key-round' }], ['AWS', { name: 'cloud' }],
  ['Bedrock', { name: 'sparkles' }], ['MCP', { name: 'plug' }], ['GitHub', { brand: 'github' }], ['Terraform', { brand: 'terraform' }],
  ['Kubernetes', { brand: 'kubernetes' }], ['Python', { brand: 'python' }], ['React', { brand: 'react' }], ['PostgreSQL', { brand: 'postgresql' }],
];

const kinds: Record<string, string> = {
  mcp: 'AI tooling',
  workflow: 'Automation',
  template: 'Platform',
  timesheets: 'Integration',
  rag: 'AI assistant',
  agents: 'AI agents',
};
---
<Base
  title="Shareef Syed · Platform and solutions engineer"
  description="Shareef Syed builds and runs an internal platform used by 200+ people. Enterprise integrations, workflow automation, AI tooling and AWS, from business request to production."
>
  <div class="sheet">
    <header class="cover">
      <div class="circles" aria-hidden="true"><span class="c1"></span><span class="c2"></span><span class="c3"></span></div>
      <nav class="topnav" aria-label="Sections">
        <a class="name" href="/">Shareef Syed</a>
        <span class="links">
          <a href="#work"><Icon name="layout-grid" size={16} />Work</a>
          <a href="#experience"><Icon name="briefcase" size={16} />Experience</a>
          <a href={links.resume}><Icon name="file-text" size={16} />Resume</a>
        </span>
      </nav>
      <p class="kicker with-icon"><Icon name="map-pin" size={14} />Platform &amp; solutions engineer · Hyderabad</p>
      <h1>I build the platform enterprise teams run on</h1>
      <p class="lede">
        At Signant Health, a clinical-trial technology company, I build and run the internal platform
        200+ people use for access requests, workflow automation, enterprise integrations and AI tooling.
        Finance, supply chain, clinical-operations and IT teams bring me requests, and I build, ship and support the result.
      </p>
      <p class="meta with-icon"><Icon name="target" size={18} />Looking for forward deployed and solutions engineering roles</p>
    </header>

    <main id="content">
      <section class="stats" aria-label="In numbers">
        {stats.map(([icon, n, l]) => (
          <div class="stat"><span class="stat-icon"><Icon name={icon} size={22} /></span><strong>{n}</strong><span>{l}</span></div>
        ))}
      </section>

      <section id="work" class="block" aria-labelledby="work-title">
        <div class="head">
          <div class="bar" aria-hidden="true"></div>
          <div class="row">
            <h2 id="work-title">Selected work</h2>
            <span class="pill">6 projects</span>
          </div>
        </div>
        <div class="apps">
          {projects.map((p) => (
            <a class="card app" href={`/projects/${p.slug}/`}>
              <span class="tile"><Icon name={projectIcons[p.slug]} size={22} /></span>
              <p class="kicker card-kicker">{kinds[p.slug]}</p>
              <h3>{p.title}</h3>
              <p>{p.blurb}</p>
              <p class="foot-row">
                <span class={`state s-${p.status.replace(' ', '-')}`}>{p.status}</span>
                <span class="go"><Icon name="arrow-right" size={18} /></span>
              </p>
            </a>
          ))}
        </div>
      </section>

      <section class="block" aria-labelledby="ss-title">
        <div class="head">
          <div class="bar" aria-hidden="true"></div>
          <div class="row">
            <h2 id="ss-title">Self-service apps on the platform</h2>
            <span class="pill">8 apps</span>
          </div>
          <p class="intro">Each app lets staff run a routine operation themselves. Every action is audited, one approval sets up access through Azure AD groups, and completed actions can raise and close their own Jira ticket.</p>
        </div>
        <div class="mini-apps">
          {selfService.map((a) => (
            <div class="card">
              <span class="tile small-tile"><Icon name={kindIcons[a.kind]} size={18} /></span>
              <p class="kicker card-kicker">{a.kind}</p>
              <h3 class="small">{a.name}</h3>
              <p>{a.line}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="block" aria-labelledby="also-title">
        <div class="head">
          <div class="bar" aria-hidden="true"></div>
          <div class="row">
            <h2 id="also-title">Also on the platform</h2>
            <span class="pill">Operations, security, cost</span>
          </div>
        </div>
        <div class="also">
          {alsoBuilt.map((a) => (
            <div class="card">
              <span class="tile small-tile"><Icon name={kindIcons[a.kind]} size={18} /></span>
              <p class="kicker card-kicker">{a.kind}</p>
              <h3 class="small">{a.name}</h3>
              <p>{a.line}</p>
            </div>
          ))}
        </div>
        {platformDiagram && (
          <a class="diagram-link" href="/diagrams/platform.html" target="_blank" rel="noopener"><Icon name="network" size={18} />See how the platform runs on Amazon EKS (interactive diagram)<Icon name="arrow-up-right" size={16} /></a>
        )}
      </section>

      <section class="block two" aria-label="How I work">
        <div class="dark">
          <p class="kicker with-icon"><Icon name="compass" size={14} />How I work</p>
          <ul class="ways">
            <li><span class="way-icon"><Icon name="users-round" size={18} /></span><span><b>Requirements from the source.</b> I work directly with the finance, supply chain, clinical-operations and IT colleagues who raise each request and who work with customers.</span></li>
            <li><span class="way-icon"><Icon name="blocks" size={18} /></span><span><b>Low-code first.</b> Routine automation is built from ready steps in a low-code workflow engine, which already handles scheduling, approvals, audit and alerts. Custom code is used where it is actually needed.</span></li>
            <li><span class="way-icon"><Icon name="layers" size={18} /></span><span><b>Full stack.</b> Data model, Python and React, integrations, deployment on AWS with Terraform, and production support.</span></li>
            <li><span class="way-icon"><Icon name="user-check" size={18} /></span><span><b>Human approval on AI work.</b> AI drafts and automates, and a person approves before anything changes.</span></li>
          </ul>
        </div>
        <div class="dark">
          <p class="kicker with-icon"><Icon name="arrow-left-right" size={14} />Systems and tools I work with</p>
          <div class="chips">
            {systems.map(([label, icon]) => <span><Icon {...icon} size={14} />{label}</span>)}
          </div>
        </div>
      </section>

      <section id="experience" class="block" aria-labelledby="exp-title">
        <div class="head">
          <div class="bar" aria-hidden="true"></div>
          <div class="row">
            <h2 id="exp-title">From Oracle DBA to platform builder</h2>
            <span class="pill">11+ years</span>
          </div>
        </div>
        <ol class="timeline">
          {experience.map((job) => (
            <li class="card">
              <p class="kicker card-kicker with-icon"><Icon name="briefcase" size={13} />{job.years}</p>
              <h3>{job.title}, {job.org}</h3>
              <p>{job.note}</p>
              <p class="tags">{job.tags.join(' · ')}</p>
            </li>
          ))}
        </ol>
      </section>


      <section class="block">
        <div class="closing">
          <div>
            <p>Open to forward deployed and solutions engineering roles.</p>
            <span class="where with-icon"><Icon name="map-pin" size={14} />Hyderabad · remote or hybrid · India, or abroad with visa sponsorship</span>
          </div>
          <div class="actions">
            <a class="cta" href={`mailto:${links.email}`}><Icon name="mail" size={16} />Email me</a>
            <a class="cta ghost" href={links.linkedin}><Icon custom="linkedin" size={16} />LinkedIn</a>
            <a class="cta ghost" href={links.resume}><Icon name="file-text" size={16} />Resume</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="foot">
      <span>Shareef Syed · Hyderabad, India</span>
      <span class="foot-links"><a href={links.linkedin}><Icon custom="linkedin" size={14} />LinkedIn</a><a href={links.github}><Icon brand="github" size={14} />GitHub</a><a href={links.resume}><Icon name="file-text" size={14} />Resume (PDF)</a></span>
    </footer>
  </div>
</Base>

<style>
  h1, h2, h3 { font-family: var(--font-display); color: var(--navy); margin: 0; font-weight: 700; text-wrap: balance; }
  b { color: var(--navy); font-weight: 600; }

  .cover { position: relative; overflow: hidden; padding: 28px 40px 44px; display: grid; gap: 14px; }
  .cover > *:not(.circles) { position: relative; z-index: 1; }
  .circles { position: absolute; right: -40px; top: 40px; width: 380px; height: 320px; pointer-events: none; }
  .circles span { position: absolute; border-radius: 50%; }
  .c1 { width: 250px; height: 250px; left: 20px; top: 40px; background: var(--systems); }
  .c2 { width: 190px; height: 190px; left: 130px; top: 0; background: var(--mist); opacity: .92; }
  .c3 { width: 130px; height: 130px; left: 80px; top: 200px; background: var(--sky); opacity: .85; }
  .topnav { display: flex; justify-content: space-between; align-items: center; margin-bottom: 36px; max-width: calc(100% - 300px); }
  .name { font: 700 22px/1 var(--font-display); color: var(--navy); text-decoration: none; letter-spacing: .01em; }
  .links { display: flex; gap: 20px; }
  .links a { color: var(--navy); text-decoration: none; font-weight: 500; }
  .links a:hover { color: var(--signal); }
  h1 { font-size: var(--step-3); line-height: 1; max-width: 13ch; }
  .lede { font-size: 18px; line-height: 1.4; max-width: 48ch; color: var(--ink); margin: 0; }
  .meta { font-weight: 600; color: var(--navy); margin: 0; }
  .with-icon { display: inline-flex; align-items: center; gap: 8px; }
  .links a { display: inline-flex; align-items: center; gap: 6px; }
  .stat-icon { color: var(--systems); opacity: .9; }
  .tile { display: inline-grid; place-items: center; width: 40px; height: 40px; border-radius: 10px; background: var(--pill); color: var(--signal); margin-bottom: 6px; }
  .small-tile { width: 34px; height: 34px; border-radius: 9px; }
  .ways { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .ways li { display: grid; grid-template-columns: 28px 1fr; gap: 10px; align-items: start; }
  .way-icon { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 8px; background: var(--navy-2); color: var(--systems); }
  .chips span { display: inline-flex; align-items: center; gap: 6px; }
  .cta { display: inline-flex; align-items: center; gap: 8px; }
  .foot-links a { display: inline-flex; align-items: center; gap: 6px; }

  main { padding: 8px 40px 32px; display: grid; gap: 40px; }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
  .stat { background: var(--navy); color: var(--band-ink); border-radius: var(--radius); padding: 16px 18px; display: grid; gap: 6px; align-content: start; }
  .stat strong { font: 700 48px/1 var(--font-display); color: var(--systems); }
  .stat span { font-size: 14px; line-height: 1.35; }

  .block { display: grid; gap: 16px; }
  .head { display: grid; gap: 10px; }
  .row { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  h2 { font-size: 32px; line-height: 1.05; }

  .card { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px 18px; display: grid; gap: 6px; align-content: start; }
  .card .card-kicker { color: var(--orange); font-size: 11px; letter-spacing: .14em; margin: 0; }
  .card h3 { font-size: 22px; line-height: 1.1; font-weight: 600; }
  .card p { margin: 0; font-size: 15px; color: var(--ink); }

  .apps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .app { text-decoration: none; color: inherit; transition: border-color 150ms var(--ease), box-shadow 150ms var(--ease), transform 150ms var(--ease); }
  .app:hover { border-color: var(--systems); box-shadow: 0 8px 24px -16px rgba(14, 42, 59, .45); transform: translateY(-2px); }
  .app:hover h3 { color: var(--signal); }
  .foot-row { display: flex; justify-content: space-between; align-items: center; margin-top: 6px !important; }
  .state { font: 600 12px/1 var(--font-sans); letter-spacing: .04em; padding: 6px 10px; border-radius: 999px; background: var(--pill); color: var(--navy); }
  .s-live { background: var(--navy); color: #f6f8fa; }
  .go { color: var(--signal); display: inline-flex; transition: transform 150ms var(--ease); }
  .app:hover .go { transform: translateX(3px); }

  .intro { margin: 0; max-width: 70ch; color: var(--ink); }
  .mini-apps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
  .card h3.small { font-size: 20px; }
  .mini-apps .card p:last-child { font-size: 14px; }
  .also { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .also .card p:last-child { font-size: 14px; }
  .two { grid-template-columns: 1fr 1fr; gap: 12px; }
  .dark { background: var(--navy); color: var(--band-ink); border-radius: var(--radius); padding: 18px 20px; display: grid; gap: 12px; align-content: start; }
  .dark .kicker { color: var(--systems); font-size: 11px; letter-spacing: .14em; margin: 0; }
  .dark b { color: #f6f8fa; }
  .tight { margin: 0; padding-left: 18px; display: grid; gap: 8px; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chips span { background: var(--navy-2); color: #e9f4fa; border-radius: 999px; padding: 5px 12px; font-size: 14px; }

  .timeline { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
  .timeline li:first-child { grid-column: 1 / -1; }
  .tags { color: var(--slate) !important; font-size: 13px !important; margin-top: 4px !important; }

  .posts { list-style: none; margin: 0; padding: 0; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); }
  .posts li { display: grid; grid-template-columns: 100px 1fr; gap: 16px; padding: 12px 18px; border-bottom: 1px solid var(--line); }
  .posts li:last-child { border-bottom: 0; }
  .when { color: var(--slate); font-size: 14px; }
  .posts a { color: var(--navy); font-weight: 500; text-decoration: none; }
  .posts a:hover { color: var(--signal); text-decoration: underline; }

  .closing { background: var(--navy); border-radius: var(--radius); padding: 22px 24px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; }
  .closing p { font: 600 28px/1.1 var(--font-display); color: var(--systems); margin: 0; max-width: 28ch; }
  .cta { background: var(--systems); color: var(--navy); font-weight: 600; padding: 12px 18px; border-radius: 10px; text-decoration: none; }
  .cta:hover { background: #f6f8fa; }
  .where { display: block; margin-top: 8px; color: var(--band-ink); font-size: 15px; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .cta.ghost { background: transparent; color: #f6f8fa; border: 1px solid var(--navy-2); }
  .cta.ghost:hover { border-color: var(--systems); color: var(--systems); background: transparent; }

  .foot { padding: 16px 40px 22px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; font-size: 13px; color: var(--slate); }
  .foot-links { display: flex; gap: 18px; }
  .foot-links a { color: var(--slate); }

  @media (max-width: 900px) {
    .apps, .mini-apps, .also { grid-template-columns: 1fr 1fr; }
    .stats { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 760px) {
    .cover, main, .foot { padding-left: 20px; padding-right: 20px; }
    .circles { opacity: .35; right: -170px; }
    .topnav { max-width: none; margin-bottom: 20px; }
    .links { gap: 14px; font-size: 15px; }
    .apps, .mini-apps, .also, .two, .timeline { grid-template-columns: 1fr; }
    .posts li { grid-template-columns: 1fr; gap: 2px; }
  }
  @media (max-width: 520px) {
    .stats { grid-template-columns: 1fr 1fr; }
    .stat strong { font-size: 40px; }
  }
  .diagram-link { display: inline-flex; align-items: center; gap: 8px; margin-top: 14px; color: var(--signal); font-weight: 600; text-decoration: none; }
  .diagram-link:hover { text-decoration: underline; }
</style>
