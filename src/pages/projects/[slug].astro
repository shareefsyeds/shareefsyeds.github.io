---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Flow from '../../components/Flow.astro';
import Icon from '../../components/Icon.astro';
import { projects } from '../../data/projects';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;
const writeup = project.slug === 'mcp' ? await getEntry('work', 'mcp-gateway') : undefined;
const Content = writeup ? (await render(writeup)).Content : null;
const i = projects.findIndex((p) => p.slug === project.slug);
const next = projects[(i + 1) % projects.length];
const diagram = existsSync(join(process.cwd(), 'public', 'diagrams', `${project.slug}.html`)) ? `/diagrams/${project.slug}.html` : null;
---
<Base title={`${project.title} · Shareef Syed`} description={project.blurb}>
  <div class="sheet"><main id="content" class="page">
    <a class="back" href="/#work"><Icon name="arrow-left" size={18} />Shareef Syed</a>
    <header class="head">
      <p class="kicker status"><span class={`dot d-${project.status.replace(' ', '-')}`} aria-hidden="true"></span>{project.status}</p>
      <h1>{project.title}</h1>
      <p class="facts mono">{project.facts.join('  ·  ')}</p>
    </header>

    <Flow stages={project.stages} caption={project.caption} />

    <dl class="story">
      <div><dt><Icon name="circle-alert" size={14} />Problem</dt><dd>{project.problem}</dd></div>
      <div><dt><Icon name="hammer" size={14} />Approach</dt><dd>{project.approach}</dd></div>
      <div><dt><Icon name="circle-check-big" size={14} />Result</dt><dd>{project.result}</dd></div>
    </dl>

    {diagram && (
      <section class="extra diagram">
        <div class="bar" aria-hidden="true"></div>
        <div class="dhead">
          <h2>Interactive diagram</h2>
          <a class="open" href={diagram} target="_blank" rel="noopener"><Icon name="maximize-2" size={16} />Open full screen</a>
        </div>
        <p class="note">Click a part to see what it does. Use the controls to zoom and switch between light and dark.</p>
        <iframe src={diagram} title={`Interactive diagram: ${project.title}`} loading="lazy"></iframe>
      </section>
    )}

    {project.sections?.map((sec) => (
      <section class="extra">
        <div class="bar" aria-hidden="true"></div>
        <h2>{sec.title}</h2>
        {sec.note && <p class="note">{sec.note}</p>}
        <div class={`grid g${Math.min(sec.cards.length, 4)}`}>
          {sec.cards.map((c) => (
            <div class="xcard"><p class="xlabel">{c.label}</p><p>{c.text}</p></div>
          ))}
        </div>
      </section>
    ))}

    {Content && (
      <article class="prose writeup">
        <h2 class="lead">The full write-up</h2>
        <Content />
      </article>
    )}

    <nav class="next" aria-label="Next project">
      <span>Next project</span>
      <a href={`/projects/${next.slug}/`}>{next.title} <Icon name="arrow-right" size={22} /></a>
    </nav>
  </main></div>
</Base>

<style>
  .page { padding: 32px 40px 48px; }
  .back { display: inline-flex; align-items: center; gap: 6px; color: var(--navy); text-decoration: none; font: 700 20px/1 var(--font-display); margin-bottom: var(--space-4); }
  .back:hover { color: var(--signal); }
  .head { margin-bottom: var(--space-4); display: grid; gap: 10px; }
  h1 { margin: 0; font-family: var(--font-display); font-size: clamp(2.4rem, 5vw, 3.4rem); line-height: 1; font-weight: 700; color: var(--navy); text-wrap: balance; max-width: 22ch; }
  .facts { color: var(--slate); font-size: 0.95rem; margin: 0; white-space: pre-wrap; }
  .status { display: flex; align-items: center; gap: 8px; margin: 0; }
  .dot { width: 8px; height: 8px; border-radius: 50%; border: 1.5px solid var(--signal); }
  .d-live { background: var(--signal); }
  .d-in-use { background: var(--systems); border-color: var(--systems); }
  .d-pilot { background: linear-gradient(90deg, var(--signal) 50%, transparent 50%); }
  .story { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin: var(--space-4) 0 0; }
  .story > div { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px 18px; }
  .story dt { display: flex; align-items: center; gap: 6px;  font: 600 11px/1 var(--font-sans); letter-spacing: .14em; text-transform: uppercase; color: var(--orange); margin-bottom: 10px; }
  .story dd { margin: 0; color: var(--ink); }
  .extra { margin-top: var(--space-5); display: grid; gap: 10px; }
  .extra h2 { font: 700 28px/1.05 var(--font-display); color: var(--navy); margin: 0; }
  .note { margin: 0; color: var(--slate); font-size: 14px; }
  .grid { display: grid; gap: 10px; margin-top: 6px; }
  .g2 { grid-template-columns: repeat(2, 1fr); }
  .g3 { grid-template-columns: repeat(3, 1fr); }
  .g4 { grid-template-columns: repeat(4, 1fr); }
  .xcard { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 14px 16px; }
  .xcard p { margin: 0; color: var(--ink); font-size: 15px; }
  .xcard .xlabel { font: 600 11px/1 var(--font-sans); letter-spacing: .14em; text-transform: uppercase; color: var(--orange); margin-bottom: 8px; }
  .dhead { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .open { display: inline-flex; align-items: center; gap: 6px; color: var(--signal); font-weight: 600; text-decoration: none; }
  .open:hover { text-decoration: underline; }
  .diagram iframe { width: 100%; height: 680px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--card); }
  @media (max-width: 760px) { .diagram iframe { height: 520px; } }
  .writeup { margin-top: var(--space-5); padding-top: var(--space-4); border-top: 1px solid var(--line); }
  .lead { margin-top: 0 !important; }
  .next { margin-top: var(--space-5); background: var(--navy); border-radius: var(--radius); padding: 20px 22px; display: flex; flex-direction: column; gap: 6px; }
  .next span { color: var(--band-ink); font-size: 0.8rem; letter-spacing: .14em; text-transform: uppercase; font-weight: 600; }
  .next a { display: inline-flex; align-items: center; gap: 8px;  font: 600 26px/1.1 var(--font-display); color: var(--systems); text-decoration: none; }
  .next a:hover { color: #f6f8fa; }
  @media (max-width: 900px) { .g4 { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 760px) { .page { padding: 24px 20px 40px; } .story, .g2, .g3, .g4 { grid-template-columns: 1fr; } }
</style>
