---
// Inline SVG icon. `name` is a Lucide icon, `brand` a Simple Icons logo, `custom` one of the paths below.
// Read at build time, so the page ships only the icons it uses.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  name?: string;
  brand?: string;
  custom?: 'linkedin';
  size?: number;
  class?: string;
}

const { name, brand, custom, size = 18, class: cls = '' } = Astro.props;
const modules = join(process.cwd(), 'node_modules');

const customPaths: Record<string, string> = {
  linkedin: 'M20.5 2h-17A1.5 1.5 0 0 0 2 3.5v17A1.5 1.5 0 0 0 3.5 22h17a1.5 1.5 0 0 0 1.5-1.5v-17A1.5 1.5 0 0 0 20.5 2ZM8 19H5v-9h3v9ZM6.5 8.3a1.7 1.7 0 1 1 0-3.5 1.7 1.7 0 0 1 0 3.5ZM19 19h-3v-4.7c0-1.1 0-2.6-1.6-2.6s-1.8 1.2-1.8 2.5V19h-3v-9h2.9v1.2h.1a3.1 3.1 0 0 1 2.8-1.6c3 0 3.6 2 3.6 4.6V19Z',
};

let svg = '';
if (name) {
  svg = readFileSync(join(modules, 'lucide-static', 'icons', `${name}.svg`), 'utf8')
    .replace(/<!--.*?-->\s*/s, '')
    .replace(/class="[^"]*"/, '')
    .replace(/width="24"/, `width="${size}"`)
    .replace(/height="24"/, `height="${size}"`);
} else if (brand) {
  svg = readFileSync(join(modules, 'simple-icons', 'icons', `${brand}.svg`), 'utf8')
    .replace(/<title>.*?<\/title>/, '')
    .replace('role="img" ', '')
    .replace('<svg ', `<svg width="${size}" height="${size}" fill="currentColor" `);
} else if (custom) {
  svg = `<svg viewBox="0 0 24 24" width="${size}" height="${size}" fill="currentColor"><path d="${customPaths[custom]}"/></svg>`;
}
svg = svg.replace('<svg', `<svg aria-hidden="true" focusable="false" class="icon ${cls}"`);
---
<Fragment set:html={svg} />
